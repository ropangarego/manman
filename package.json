{
  "name": "manman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "packs:index": "tsx scripts/generate-pack-index.ts",
    "validate:packs": "tsx scripts/validate-packs.ts",
    "seed:sql": "node scripts/generate-supabase-seed.cjs",
    "content:check": "npm run packs:index && npm run validate:packs && npm run build",
    "content:release": "npm run packs:index && npm run validate:packs && npm run seed:sql && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.90.12",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.9"
  }
